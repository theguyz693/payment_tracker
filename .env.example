# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Database name (optional, default: payment_tracker)
MONGODB_DB="payment_tracker"

# Long random secret for signing sessions. Generate one with:
#   npx @better-auth/cli secret      or      openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The public URL of the app (no trailing slash)
#   local:  http://localhost:3000
#   Vercel: https://your-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Optional. Fallback timezone for "today" before the browser reports one.
# DEFAULT_TIMEZONE="Asia/Kolkata"

# Optional. Only for a local standalone mongod (no replica set). Leave unset for Atlas.
# MONGODB_TRANSACTIONS="false"
